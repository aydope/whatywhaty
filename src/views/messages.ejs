<!DOCTYPE html>
<html dir="rtl" lang="fa">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>پیام‌ها · واتی‌واتی</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/public/css/messages.css" />
  </head>

  <body
    data-user-id="<%= user._id %>"
    data-username="<%= user.username %>"
    data-preselected="<%= preselectedUser || '' %>"
  >
    <header class="tg-header">
      <div class="tg-header-left">
        <span class="tg-header-title">واتی‌واتی</span>
      </div>
      <div class="tg-header-actions">
        <a class="tg-header-btn" href="/" aria-label="خانه">
          <span class="material-symbols-rounded">home</span>
        </a>
        <a class="tg-header-btn" href="/explore" aria-label="اکتشاف">
          <span class="material-symbols-rounded">explore</span>
        </a>
        <a class="tg-header-btn" href="/@<%= user.username %>" aria-label="پروفایل">
          <span class="material-symbols-rounded">person</span>
        </a>
        <button class="tg-header-btn" id="logoutBtn" aria-label="خروج">
          <span class="material-symbols-rounded" style="color: var(--danger-color)">logout</span>
        </button>
      </div>
    </header>

    <div class="tg-container">
      <div class="tg-conversations" id="sidebar">
        <div class="tg-conversations-header">
          <div class="tg-search-wrap">
            <span class="material-symbols-rounded">search</span>
            <input
              class="tg-search-input"
              id="searchUserInput"
              placeholder="جستجو با نام یا @آیدی..."
              autocomplete="off"
              maxlength="64"
            />
            <button class="tg-search-clear" id="searchClearBtn" aria-label="پاک کردن">
              <span class="material-symbols-rounded" style="font-size: 18px">close</span>
            </button>
          </div>
        </div>

        <div class="tg-conv-list" id="conversationsListWrapper">
          <div id="conversationsContainer"></div>
          <div class="tg-search-results" id="searchResultsOverlay">
            <div id="searchResultsContent"></div>
          </div>
        </div>
      </div>

      <div class="tg-chat" id="chatArea">
        <div class="tg-chat-header" id="chatHeader" style="display: none">
          <button class="tg-chat-back" id="chatBackBtn" aria-label="بازگشت">
            <span class="material-symbols-rounded">arrow_back</span>
          </button>
          <a href="#" id="chatProfileLink" class="tg-chat-avatar">
            <span id="avatarLetter"></span>
            <div class="tg-online-dot" id="onlineDot" style="display: none"></div>
          </a>
          <a href="#" id="chatProfileLinkText" class="tg-chat-info" style="text-decoration: none; color: inherit">
            <div class="tg-chat-name" id="chatUsername"></div>
            <div class="tg-chat-handle" id="chatHandle"></div>
            <div class="tg-chat-status" id="chatStatus">
              <span id="statusText">آفلاین</span>
              <span id="typingHeaderIndicator" style="display: none">
                <span class="typing-dots-inline"><span></span><span></span><span></span></span>
                <span style="color: var(--accent-color)">در حال تایپ...</span>
              </span>
            </div>
          </a>
        </div>

        <div class="tg-pinned" id="pinnedBar" hidden>
          <div class="tg-pinned-indicator"></div>
          <div class="tg-pinned-body">
            <div class="tg-pinned-title" id="pinnedTitle">پیام پین‌شده</div>
            <div class="tg-pinned-text" id="pinnedText"></div>
          </div>
          <button class="tg-icon-btn" id="pinnedUnpinBtn" aria-label="برداشتن پین">
            <span class="material-symbols-rounded">keep_off</span>
          </button>
        </div>

        <div id="blockedNotice" class="tg-blocked-notice" style="display: none">
          <span class="material-symbols-rounded" style="font-size: 22px">block</span>
          <div>
            <div style="font-weight: 500; margin-bottom: 2px">دسترسی محدود</div>
            <span style="font-size: 13px; opacity: 0.8">شما توسط این کاربر بلاک شده‌اید</span>
          </div>
        </div>
        <div id="blockedByYouNotice" class="tg-blocked-notice tg-blocked-by-you" style="display: none">
          <span class="material-symbols-rounded" style="font-size: 22px">block</span>
          <div style="flex: 1">
            <div style="font-weight: 500; margin-bottom: 2px">کاربر بلاک شده</div>
            <span style="font-size: 13px; opacity: 0.8">شما این کاربر را بلاک کرده‌اید</span>
          </div>
          <button class="tg-notice-btn" id="unblockBtn">رفع بلاک</button>
        </div>

        <div id="chatEmpty" class="tg-empty">
          <span class="material-symbols-rounded">chat_bubble_outline</span>
          <h3>یک گفتگو را انتخاب کنید</h3>
          <p>از لیست پیام‌ها یک کاربر را انتخاب کنید</p>
        </div>

        <div class="tg-messages-wrap" id="messagesWrap" style="display: none">
          <div class="tg-messages" id="messagesContainer"></div>
          <button class="tg-scroll-down" id="scrollDownBtn" aria-label="رفتن به آخرین پیام">
            <span class="tg-scroll-badge" id="scrollDownBadge" hidden></span>
            <span class="material-symbols-rounded">keyboard_arrow_down</span>
          </button>
        </div>

        <div class="tg-reply-bar" id="replyBar" hidden>
          <span class="material-symbols-rounded tg-reply-icon">reply</span>
          <div class="tg-pinned-indicator"></div>
          <div class="tg-pinned-body">
            <div class="tg-pinned-title" id="replyName"></div>
            <div class="tg-pinned-text" id="replyText"></div>
          </div>
          <button class="tg-icon-btn" id="replyCancelBtn" aria-label="لغو پاسخ">
            <span class="material-symbols-rounded">close</span>
          </button>
        </div>

        <div class="tg-input-area" id="messageInputArea" style="display: none">
          <div class="tg-input-wrap">
            <textarea
              class="tg-input"
              id="messageText"
              placeholder="پیام..."
              maxlength="1000"
              rows="1"
              autocomplete="off"
            ></textarea>
          </div>
          <button class="tg-send-btn" id="sendBtn" aria-label="ارسال">
            <span class="material-symbols-rounded" style="font-size: 22px">send</span>
          </button>
        </div>
      </div>
    </div>

    <div class="tg-context-menu" id="contextMenu" role="menu"></div>

    <div class="tg-modal-overlay" id="confirmDeleteModal">
      <div class="tg-modal">
        <div class="icon-wrap">
          <span class="material-symbols-rounded">delete</span>
        </div>
        <h3>حذف پیام</h3>
        <p>آیا مطمئن هستید که می‌خواهید این پیام را حذف کنید؟</p>
        <div class="for-both-option show" id="forBothOption">
          <label>
            <input type="checkbox" id="forBothCheckbox" />
            <span id="forBothLabel">حذف برای هر دو طرف</span>
          </label>
        </div>
        <div class="buttons">
          <button class="btn btn-cancel" id="cancelDeleteBtn">انصراف</button>
          <button class="btn btn-danger" id="confirmDeleteBtn">حذف</button>
        </div>
      </div>
    </div>

    <div class="tg-toast-container" id="toastContainer"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/js/messages.js" defer></script>
  </body>
</html>
