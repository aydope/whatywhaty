<!DOCTYPE html>
<html dir="rtl" lang="fa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>پنل مدیریت · واتی‌واتی</title>
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Vazirmatn", "Sahel", "sans-serif"],
            },
            colors: {
              primary: "#3390ec",
              danger: "#e53935",
              success: "#4caf50",
              warning: "#f9a825",
              dark: "#212121",
              muted: "#707579",
              light: "#f5f5f5",
              border: "#e0e0e0",
            },
          },
        },
      };
    </script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Vazirmatn", "Sahel", sans-serif;
        background: #eef2f5;
        color: #212121;
        direction: rtl;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .tg-header {
        background: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .tg-header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        gap: 6px;
      }

      .tg-logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        background: #3390ec;
        color: white;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .tg-admin-badge {
        background: #e3f2fd;
        color: #1565c0;
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 0.6rem;
        font-weight: 500;
        white-space: nowrap;
      }

      .tg-mobile-menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: none;
        background: none;
        cursor: pointer;
        border-radius: 50%;
        transition: background 0.15s;
        font-size: 1.3rem;
        color: #707579;
      }

      .tg-mobile-menu-btn:active {
        background: #f0f0f0;
      }

      .tg-mobile-menu {
        position: fixed;
        top: 0;
        right: -280px;
        width: 260px;
        height: 100%;
        background: #ffffff;
        z-index: 100;
        transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
        padding: 16px 12px;
        overflow-y: auto;
      }

      .tg-mobile-menu.open {
        right: 0;
      }

      .tg-mobile-menu-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 99;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s;
      }

      .tg-mobile-menu-overlay.active {
        opacity: 1;
        visibility: visible;
      }

      .tg-mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 12px;
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 10px;
      }

      .tg-mobile-menu-close {
        width: 32px;
        height: 32px;
        border: none;
        background: none;
        cursor: pointer;
        border-radius: 50%;
        font-size: 1.2rem;
        color: #707579;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .tg-mobile-menu-close:active {
        background: #f0f0f0;
      }

      .tg-mobile-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        color: #212121;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: background 0.15s;
        margin-bottom: 2px;
      }

      .tg-mobile-menu-item:active {
        background: #f0f0f0;
      }

      .tg-mobile-menu-item.danger {
        color: #e53935;
      }

      .tg-mobile-menu-item i {
        font-size: 1.1rem;
        width: 22px;
      }

      .tg-mobile-user-info {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #f8f9fa;
        margin-bottom: 8px;
      }

      .tg-mobile-user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #3390ec;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
        flex-shrink: 0;
      }

      .tg-desktop-nav {
        display: none;
        align-items: center;
        gap: 4px;
      }

      .tg-desktop-nav a {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 6px;
        color: #707579;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.15s;
      }

      .tg-desktop-nav a:hover {
        background: #f0f0f0;
        color: #212121;
      }

      .tg-desktop-nav a.danger {
        color: #e53935;
      }

      .tg-desktop-nav a.danger:hover {
        background: #ffebee;
      }

      .tg-stat-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 14px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      .tg-stat-card:active {
        transform: scale(0.97);
      }

      .tg-stat-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin: 0 auto 6px;
      }

      .tg-tabs {
        display: flex;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 8px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      .tg-tab-btn {
        flex: 1;
        padding: 10px 8px;
        cursor: pointer;
        color: #707579;
        border: none;
        background: none;
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
      }

      .tg-tab-btn.active {
        color: #3390ec;
        border-bottom-color: #3390ec;
        font-weight: 600;
      }

      .tg-tab-content {
        display: none;
        animation: fadeIn 0.15s ease;
      }

      .tg-tab-content.active {
        display: block;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .tg-list-card {
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      .tg-row {
        padding: 10px 12px;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.1s;
      }

      .tg-row:active {
        background: #f5f5f5;
      }

      .tg-row:last-child {
        border-bottom: none;
      }

      .tg-btn {
        padding: 5px 10px;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }

      .tg-btn-danger {
        background: #ffebee;
        color: #e53935;
      }

      .tg-btn-danger:active {
        background: #e53935;
        color: white;
      }

      .tg-badge {
        display: inline-block;
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 0.62rem;
        font-weight: 500;
      }

      .tg-badge-admin {
        background: #ffebee;
        color: #e53935;
      }

      .tg-badge-user {
        background: #f0f0f0;
        color: #707579;
      }

      .tg-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.8rem;
        color: white;
        flex-shrink: 0;
      }

      .tg-search {
        width: 100%;
        padding: 8px 12px;
        border: none;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.82rem;
        background: #f0f2f5;
        transition: all 0.2s;
      }

      .tg-search:focus {
        outline: none;
        background: #ffffff;
        box-shadow: 0 0 0 2px #3390ec;
      }

      .tg-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        padding: 8px;
        flex-wrap: wrap;
      }

      .tg-pagination-btn {
        padding: 4px 8px;
        border-radius: 4px;
        border: none;
        background: #f0f2f5;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.7rem;
        font-weight: 500;
        transition: all 0.15s;
        color: #707579;
        min-width: 28px;
      }

      .tg-pagination-btn.active {
        background: #3390ec;
        color: white;
      }

      .tg-pagination-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .tg-toast {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 500;
        z-index: 1000;
        animation: slideUp 0.2s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        font-family: inherit;
        font-size: 0.8rem;
        white-space: nowrap;
        max-width: 90%;
      }

      .tg-toast-success {
        background: #e8f5e9;
        color: #2e7d32;
      }

      .tg-toast-error {
        background: #ffebee;
        color: #c62828;
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateX(-50%) translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateX(-50%) translateY(0);
        }
      }

      .tg-empty {
        text-align: center;
        padding: 30px 15px;
        color: #707579;
      }

      .tg-empty i {
        font-size: 2rem;
        display: block;
        margin-bottom: 8px;
        color: #bdbdbd;
      }

      .tg-spinner {
        width: 24px;
        height: 24px;
        border: 2px solid #e0e0e0;
        border-top-color: #3390ec;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        margin: 15px auto;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .tg-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.15s ease;
      }

      .tg-modal-overlay.active {
        display: flex;
      }

      .tg-modal {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px;
        max-width: 320px;
        width: 92%;
        text-align: center;
        animation: scaleIn 0.2s ease;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      }

      @keyframes scaleIn {
        from {
          opacity: 0;
          transform: scale(0.92);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .tg-modal-icon {
        font-size: 2rem;
        color: #e53935;
        margin-bottom: 8px;
        display: block;
      }

      .tg-modal-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #212121;
        margin-bottom: 6px;
      }

      .tg-modal-text {
        font-size: 0.8rem;
        color: #707579;
        margin-bottom: 14px;
        line-height: 1.5;
      }

      .tg-modal-buttons {
        display: flex;
        gap: 6px;
        justify-content: center;
      }

      .tg-modal-btn {
        padding: 7px 16px;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        transition: all 0.15s;
      }

      .tg-modal-cancel {
        background: #f0f2f5;
        color: #707579;
      }

      .tg-modal-cancel:active {
        background: #e0e0e0;
      }

      .tg-modal-danger {
        background: #e53935;
        color: white;
      }

      .tg-modal-danger:active {
        background: #c62828;
      }

      @media (min-width: 769px) {
        .tg-header-inner {
          padding: 0 20px;
        }
        .tg-mobile-menu-btn {
          display: none;
        }
        .tg-desktop-nav {
          display: flex;
        }
        .tg-stat-card {
          padding: 18px 16px;
        }
        .tg-row {
          padding: 12px 16px;
        }
        .tg-tab-btn {
          font-size: 0.85rem;
          padding: 12px 16px;
        }
      }
    </style>
  </head>
  <body class="font-sans">
    <header class="tg-header">
      <div class="tg-header-inner">
        <button class="tg-mobile-menu-btn" onclick="openMobileMenu()">
          <i class="bi bi-list"></i>
        </button>

        <div class="flex items-center gap-2 min-w-0 flex-1 md:flex-none">
          <span class="tg-logo">و</span>
          <span class="font-semibold text-dark text-sm truncate"
            >واتی‌واتی</span
          >
          <span class="tg-admin-badge hidden sm:inline-block">
            <i class="bi bi-shield-lock ml-0.5"></i>
            مدیریت
          </span>
        </div>

        <div class="tg-desktop-nav">
          <a href="/">
            <i class="bi bi-house"></i>
            خانه
          </a>
          <span class="text-muted text-xs flex items-center gap-1">
            <i class="bi bi-person-circle"></i>
            <%= admin.username %>
          </span>
          <a href="/auth/logout" class="danger">
            <i class="bi bi-box-arrow-left"></i>
            خروج
          </a>
        </div>
      </div>
    </header>

    <div
      class="tg-mobile-menu-overlay"
      id="mobileMenuOverlay"
      onclick="closeMobileMenu()"
    ></div>
    <div class="tg-mobile-menu" id="mobileMenu">
      <div class="tg-mobile-menu-header">
        <div class="flex items-center gap-2">
          <span
            class="tg-logo"
            style="width: 30px; height: 30px; font-size: 0.85rem"
            >و</span
          >
          <span class="font-semibold text-dark text-sm">واتی‌واتی</span>
        </div>
        <button class="tg-mobile-menu-close" onclick="closeMobileMenu()">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="tg-mobile-user-info">
        <div class="tg-mobile-user-avatar">
          <%= admin.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="font-medium text-dark text-xs">
            @<%= admin.username %>
          </div>
          <div class="text-xs text-muted">ادمین</div>
        </div>
      </div>

      <a href="/" class="tg-mobile-menu-item">
        <i class="bi bi-house"></i>
        خانه
      </a>
      <a href="/auth/logout" class="tg-mobile-menu-item danger">
        <i class="bi bi-box-arrow-left"></i>
        خروج از حساب
      </a>
    </div>

    <main class="max-w-3xl mx-auto px-2.5 py-3">
      <div class="grid grid-cols-3 gap-2 mb-2.5">
        <div class="tg-stat-card" onclick="switchTab('users')">
          <div class="tg-stat-icon" style="background: #e3f2fd; color: #1565c0">
            <i class="bi bi-people-fill"></i>
          </div>
          <div class="text-lg font-semibold text-dark">
            <%= stats.totalUsers %>
          </div>
          <div class="text-xs text-muted">کاربر</div>
        </div>
        <div class="tg-stat-card" onclick="switchTab('posts')">
          <div class="tg-stat-icon" style="background: #fff8e1; color: #f57f17">
            <i class="bi bi-file-text-fill"></i>
          </div>
          <div class="text-lg font-semibold text-dark">
            <%= stats.totalPosts %>
          </div>
          <div class="text-xs text-muted">پست</div>
        </div>
        <div class="tg-stat-card" onclick="switchTab('comments')">
          <div class="tg-stat-icon" style="background: #e8f5e9; color: #2e7d32">
            <i class="bi bi-chat-dots-fill"></i>
          </div>
          <div class="text-lg font-semibold text-dark">
            <%= stats.totalComments %>
          </div>
          <div class="text-xs text-muted">کامنت</div>
        </div>
      </div>

      <div class="tg-tabs">
        <button class="tg-tab-btn active" onclick="switchTab('users')">
          <i class="bi bi-people"></i>
          <span>کاربران</span>
        </button>
        <button class="tg-tab-btn" onclick="switchTab('posts')">
          <i class="bi bi-file-text"></i>
          <span>پست‌ها</span>
        </button>
        <button class="tg-tab-btn" onclick="switchTab('comments')">
          <i class="bi bi-chat-dots"></i>
          <span>کامنت‌ها</span>
        </button>
      </div>

      <div id="usersTab" class="tg-tab-content active">
        <div class="p-2.5">
          <input
            type="text"
            class="tg-search"
            placeholder="جستجوی کاربر..."
            oninput="filterUsers(this.value)"
          />
        </div>
        <div class="tg-list-card" id="usersList"></div>
        <div id="usersPagination" class="tg-pagination"></div>
      </div>

      <div id="postsTab" class="tg-tab-content">
        <div class="tg-list-card" id="postsList">
          <div class="flex items-center justify-center py-8">
            <div class="tg-spinner"></div>
          </div>
        </div>
        <div id="postsPagination" class="tg-pagination"></div>
      </div>

      <div id="commentsTab" class="tg-tab-content">
        <div class="tg-list-card" id="commentsList">
          <div class="flex items-center justify-center py-8">
            <div class="tg-spinner"></div>
          </div>
        </div>
        <div id="commentsPagination" class="tg-pagination"></div>
      </div>
    </main>

    <div class="tg-modal-overlay" id="confirmModal">
      <div class="tg-modal">
        <span class="tg-modal-icon">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </span>
        <h3 class="tg-modal-title" id="modalTitle">تأیید حذف</h3>
        <p class="tg-modal-text" id="modalText">
          آیا از انجام این عملیات اطمینان دارید؟
        </p>
        <div class="tg-modal-buttons">
          <button
            class="tg-modal-btn tg-modal-cancel"
            onclick="closeConfirmModal()"
          >
            انصراف
          </button>
          <button class="tg-modal-btn tg-modal-danger" id="modalConfirmBtn">
            حذف
          </button>
        </div>
      </div>
    </div>

    <%- include('../partials/scripts') %>
    <script>
      let currentUsersPage = 1;
      let currentPostsPage = 1;
      let currentCommentsPage = 1;
      let usersTotalPages = 1;
      let postsTotalPages = 1;
      let commentsTotalPages = 1;
      let usersLoaded = false;
      let postsLoaded = false;
      let commentsLoaded = false;
      let pendingAction = null;

      function openMobileMenu() {
        document.getElementById("mobileMenu").classList.add("open");
        document.getElementById("mobileMenuOverlay").classList.add("active");
        document.body.style.overflow = "hidden";
      }

      function closeMobileMenu() {
        document.getElementById("mobileMenu").classList.remove("open");
        document.getElementById("mobileMenuOverlay").classList.remove("active");
        document.body.style.overflow = "";
      }

      function switchTab(name) {
        document
          .querySelectorAll(".tg-tab-btn")
          .forEach((b) => b.classList.remove("active"));
        document
          .querySelectorAll(".tg-tab-content")
          .forEach((c) => c.classList.remove("active"));

        const tabMap = {
          users: { btn: 0, content: "usersTab" },
          posts: { btn: 1, content: "postsTab" },
          comments: { btn: 2, content: "commentsTab" },
        };

        const tab = tabMap[name];
        if (!tab) return;

        document
          .querySelectorAll(".tg-tab-btn")
          [tab.btn].classList.add("active");
        document.getElementById(tab.content).classList.add("active");

        if (name === "users" && !usersLoaded) loadUsers(1);
        if (name === "posts" && !postsLoaded) loadPosts(1);
        if (name === "comments" && !commentsLoaded) loadComments(1);
      }

      function showConfirmModal(title, text, onConfirm) {
        document.getElementById("modalTitle").textContent = title;
        document.getElementById("modalText").textContent = text;
        document.getElementById("confirmModal").classList.add("active");
        pendingAction = onConfirm;
      }

      function closeConfirmModal() {
        document.getElementById("confirmModal").classList.remove("active");
        pendingAction = null;
      }

      document
        .getElementById("modalConfirmBtn")
        .addEventListener("click", function () {
          if (pendingAction) {
            pendingAction();
            closeConfirmModal();
          }
        });

      document
        .getElementById("confirmModal")
        .addEventListener("click", function (e) {
          if (e.target === this) closeConfirmModal();
        });

      async function loadUsers(page) {
        const container = document.getElementById("usersList");
        container.innerHTML = '<div class="tg-spinner"></div>';

        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/users?page=${page}&limit=10`,
          );
          const data = await res.json();

          if (data.success) {
            usersLoaded = true;
            currentUsersPage = page;
            usersTotalPages = data.totalPages || 1;
            displayUsers(data.users || []);
            renderPagination(
              "usersPagination",
              currentUsersPage,
              usersTotalPages,
              loadUsers,
            );
          } else {
            container.innerHTML =
              '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
          }
        } catch (e) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
        }
      }

      function displayUsers(users) {
        const container = document.getElementById("usersList");

        if (!users || users.length === 0) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-people"></i><p>کاربری یافت نشد</p></div>';
          return;
        }

        container.innerHTML = users
          .map(
            (user) => `
        <div class="tg-row flex items-center justify-between gap-2" data-user-id="${user._id}" data-username="${user.username}">
          <div class="flex items-center gap-2 min-w-0">
            <div class="tg-avatar" style="background:#3390ec;">
              ${user.username.charAt(0).toUpperCase()}
            </div>
            <div class="min-w-0">
              <div class="font-medium text-dark text-xs truncate">
                @${user.username}
                <span class="tg-badge ${user.role === "admin" ? "tg-badge-admin" : "tg-badge-user"} mr-1">
                  ${user.role === "admin" ? "مدیر" : "کاربر"}
                </span>
              </div>
              <div class="text-xs text-muted truncate">${user.email}</div>
            </div>
          </div>
          <div class="flex items-center flex-shrink-0">
            ${
              user._id !== "<%= admin._id %>" && user.role !== "admin"
                ? `
              <button class="tg-btn tg-btn-danger" onclick="requestDeleteUser('${user._id}', '@${user.username}')">
                <i class="bi bi-trash"></i>
              </button>
            `
                : user._id === "<%= admin._id %>"
                  ? `
              <span class="text-xs text-muted">شما</span>
            `
                  : `
              <span class="text-xs text-muted">مدیر</span>
            `
            }
          </div>
        </div>
      `,
          )
          .join("");
      }

      async function loadPosts(page) {
        const container = document.getElementById("postsList");
        container.innerHTML = '<div class="tg-spinner"></div>';

        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/posts?page=${page}&limit=10`,
          );
          const data = await res.json();

          if (data.success) {
            postsLoaded = true;
            currentPostsPage = page;
            postsTotalPages = data.totalPages || 1;
            displayPosts(data.posts || []);
            renderPagination(
              "postsPagination",
              currentPostsPage,
              postsTotalPages,
              loadPosts,
            );
          } else {
            container.innerHTML =
              '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
          }
        } catch (e) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
        }
      }

      function displayPosts(posts) {
        const container = document.getElementById("postsList");

        if (!posts || posts.length === 0) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-file-text"></i><p>پستی یافت نشد</p></div>';
          return;
        }

        container.innerHTML = posts
          .map(
            (post) => `
        <div class="tg-row" data-post-id="${post._id}">
          <div class="flex items-center gap-2 mb-1.5">
            <div class="tg-avatar" style="background:#f57f17;width:26px;height:26px;font-size:0.7rem;">
              ${(post.author?.username || "?").charAt(0).toUpperCase()}
            </div>
            <span class="font-medium text-dark text-xs truncate">@${post.author?.username || "unknown"}</span>
            <span class="text-xs text-muted mr-auto flex-shrink-0">${new Date(post.createdAt).toLocaleString("fa-IR-u-nu-latn")}</span>
          </div>
          <div class="text-dark text-xs mb-1.5" style="white-space:pre-wrap;word-break:break-word;">${escapeHtml(post.content || "")}</div>
          <div class="flex items-center justify-between text-xs text-muted">
            <div class="flex items-center gap-2.5">
              <span><i class="bi bi-heart ml-0.5"></i>${post.likes?.length || 0}</span>
              <span><i class="bi bi-chat ml-0.5"></i>${post.comments?.length || 0}</span>
            </div>
            <button class="tg-btn tg-btn-danger" onclick="requestDeletePost('${post._id}')">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
      `,
          )
          .join("");
      }

      async function loadComments(page) {
        const container = document.getElementById("commentsList");
        container.innerHTML = '<div class="tg-spinner"></div>';

        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/comments?page=${page}&limit=10`,
          );
          const data = await res.json();

          if (data.success) {
            commentsLoaded = true;
            currentCommentsPage = page;
            commentsTotalPages = data.totalPages || 1;
            displayComments(data.comments || []);
            renderPagination(
              "commentsPagination",
              currentCommentsPage,
              commentsTotalPages,
              loadComments,
            );
          } else {
            container.innerHTML =
              '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
          }
        } catch (e) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
        }
      }

      function displayComments(comments) {
        const container = document.getElementById("commentsList");

        if (!comments || comments.length === 0) {
          container.innerHTML =
            '<div class="tg-empty"><i class="bi bi-chat-dots"></i><p>کامنتی یافت نشد</p></div>';
          return;
        }

        container.innerHTML = comments
          .map(
            (comment) => `
        <div class="tg-row" data-comment-id="${comment._id}">
          <div class="flex items-center gap-2 mb-1.5">
            <div class="tg-avatar" style="background:#2e7d32;width:26px;height:26px;font-size:0.7rem;">
              ${(comment.author?.username || "?").charAt(0).toUpperCase()}
            </div>
            <span class="font-medium text-dark text-xs truncate">@${comment.author?.username || "unknown"}</span>
            <span class="text-xs text-muted mr-auto flex-shrink-0">${new Date(comment.createdAt).toLocaleString("fa-IR-u-nu-latn")}</span>
          </div>
          <div class="text-dark text-xs mb-1.5" style="white-space:pre-wrap;word-break:break-word;">${escapeHtml(comment.content || "")}</div>
          ${
            comment.post
              ? `
            <div class="text-xs text-muted mb-1.5 bg-gray-50 p-1.5 rounded truncate">
              <i class="bi bi-file-text ml-0.5"></i>
              ${escapeHtml(comment.post.content?.substring(0, 50) || "")}...
            </div>
          `
              : ""
          }
          <div class="flex items-center justify-end">
            <button class="tg-btn tg-btn-danger" onclick="requestDeleteComment('${comment._id}')">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
      `,
          )
          .join("");
      }

      function renderPagination(containerId, currentPage, totalPages, loadFn) {
        const container = document.getElementById(containerId);
        if (totalPages <= 1) {
          container.innerHTML = "";
          return;
        }

        let html = "";
        html += `<button class="tg-pagination-btn" onclick="${loadFn.name}(${currentPage - 1})" ${currentPage === 1 ? "disabled" : ""}>‹</button>`;

        for (let i = 1; i <= totalPages; i++) {
          if (i === currentPage) {
            html += `<button class="tg-pagination-btn active">${i}</button>`;
          } else if (
            i === 1 ||
            i === totalPages ||
            (i >= currentPage - 1 && i <= currentPage + 1)
          ) {
            html += `<button class="tg-pagination-btn" onclick="${loadFn.name}(${i})">${i}</button>`;
          } else if (i === currentPage - 2 || i === currentPage + 2) {
            html += `<span class="text-muted text-xs">...</span>`;
          }
        }

        html += `<button class="tg-pagination-btn" onclick="${loadFn.name}(${currentPage + 1})" ${currentPage === totalPages ? "disabled" : ""}>›</button>`;

        container.innerHTML = html;
      }

      function filterUsers(query) {
        const rows = document.querySelectorAll("#usersList .tg-row");
        const q = query.toLowerCase().trim();
        rows.forEach((row) => {
          const username = (row.dataset.username || "").toLowerCase();
          row.style.display = !q || username.includes(q) ? "flex" : "none";
        });
      }

      function requestDeleteUser(userId, username) {
        showConfirmModal(
          "حذف کاربر",
          `آیا از حذف کاربر ${username} و تمام محتوای ایشان اطمینان دارید؟`,
          () => deleteUser(userId),
        );
      }

      function requestDeletePost(postId) {
        showConfirmModal(
          "حذف پست",
          "آیا از حذف این پست و تمام کامنت‌های آن اطمینان دارید؟",
          () => deletePost(postId),
        );
      }

      function requestDeleteComment(commentId) {
        showConfirmModal(
          "حذف کامنت",
          "آیا از حذف این کامنت و تمام ریپلای‌های آن اطمینان دارید؟",
          () => deleteComment(commentId),
        );
      }

      async function deleteUser(userId) {
        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/users/${userId}`,
            { method: "DELETE" },
          );
          const data = await res.json();

          if (data.success) {
            showToast("کاربر با موفقیت حذف شد", "success");
            window.location.reload();
          } else {
            showToast(data.message || "خطا در حذف", "error");
          }
        } catch (e) {
          showToast("خطا در ارتباط", "error");
        }
      }

      async function deletePost(postId) {
        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/posts/${postId}`,
            { method: "DELETE" },
          );
          const data = await res.json();

          if (data.success) {
            showToast("پست با موفقیت حذف شد", "success");
            window.location.reload();
          } else {
            showToast(data.message || "خطا", "error");
          }
        } catch (e) {
          showToast("خطا در ارتباط", "error");
        }
      }

      async function deleteComment(commentId) {
        try {
          const res = await tokenManager.fetchWithAuth(
            `/admin/comments/${commentId}`,
            { method: "DELETE" },
          );
          const data = await res.json();

          if (data.success) {
            showToast("کامنت با موفقیت حذف شد", "success");
            window.location.reload();
          } else {
            showToast(data.message || "خطا", "error");
          }
        } catch (e) {
          showToast("خطا در ارتباط", "error");
        }
      }

      function escapeHtml(text) {
        if (!text) return "";
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      function showToast(message, type = "success") {
        const existing = document.querySelector(".tg-toast");
        if (existing) existing.remove();
        const toast = document.createElement("div");
        toast.className = `tg-toast tg-toast-${type}`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transition = "opacity 0.2s";
          setTimeout(() => toast.remove(), 200);
        }, 2500);
      }

      loadUsers(1);
    </script>
  </body>
</html>
